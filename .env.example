# status-board 環境変数のひな形
#
# このファイルは値を持たない（`.gitignore` で `.env*` を除外し、これだけを例外として通している）。
# 実際の値は `.env.local` に書く。**絶対にコミットしないこと。**
#
# 使い方:
#   cp .env.example .env.local   して、.env.local の = の右側を埋める
#
# 前提: Notion の Integration は「status-board Quests DB」と
#       「work-dashboard タスクDB」の**両方に接続**しておくこと。
#       Notion は DB ごとに接続を許可する方式のため、片方だけだと 404 になる。

# ── Notion 認証 ─────────────────────────────────────────────
# Notion Integration Token（https://www.notion.so/my-integrations で発行）。
# `secret_` で始まる文字列。サーバーサイド専用。
# **`NEXT_PUBLIC_` を付けてはならない**（付けるとクライアントに漏れる）。
NOTION_API_KEY=

# ── データベース ID ─────────────────────────────────────────
# DB の ID は Notion で DB を開いたときの URL から取れる:
#   https://www.notion.so/<workspace>/<32桁の英数字>?v=...
#                                     ^^^^^^^^^^^^^^ ここ
# ハイフンの有無はどちらでもよい（API は両方受け付ける）。

# status-board Quests DB（新規作成する）。
# デイリー5個 / ボス / 測定期間14件を持つ。仕事のタスクはここに入れない。
NOTION_QUESTS_DB_ID=

# work-dashboard のタスクDB（既存。**読み取り専用で使う**）。
# プロジェクト / フェーズ / タスクが `種別`(select) + `親`(relation) で同居している。
# status-board はここから完了タスクを取得して EXP を算出し、証拠として page_id を参照する。
# **status-board からこの DB に書き込まないこと**（work-dashboard が唯一の書き込み元）。
NOTION_TASKS_DB_ID=

# ── 書き込み保護 ────────────────────────────────────────────
# status-board 上でデイリーにチェックを付けられるようにするため、
# 書き込み API を認証で保護する。公開 URL のままでは誰でも押せてしまう。
# 認証方式は未確定（docs/10_notion_schema.md）。以下は Basic 認証を採る場合の枠。
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
